# Copy to secrets.yaml (next to thermostat.yaml) and fill in.
# secrets.yaml is in .gitignore — never commit it.
wifi_ssid: "your-network"
wifi_password: "your-wifi-password"

# 32-byte base64 key; generate one at https://esphome.io/components/api/
# or reuse the key Home Assistant already knows for this device.
api_encryption_key: "replace-with-your-base64-key"

# Password for the "Thermostat Fallback" hotspot (8+ characters)
fallback_ap_password: "change-me-please"
